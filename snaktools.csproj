<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Icono del .exe (el archivo snaktools.ico debe estar en esta misma carpeta) -->
    <ApplicationIcon>snaktools.ico</ApplicationIcon>

    <!-- Quita el comentario de la siguiente línea cuando generes el .exe para el release:
         hace que Windows pida permisos de administrador al abrirlo con doble clic.
         Con esto activado, "dotnet run" desde una terminal normal falla; usa una terminal como administrador. -->
    <!-- <ApplicationManifest>app.manifest</ApplicationManifest> -->
  </PropertyGroup>

</Project>
